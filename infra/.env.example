#!/usr/bin/env bash
# Copy to infra/.env, fill in the values, then load with: . infra/.env

export TF_VAR_cloudflare_account_id="YOUR_CLOUDFLARE_ACCOUNT_ID"
export CLOUDFLARE_API_TOKEN="YOUR_SETUP_API_TOKEN"
export AWS_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
export AWS_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
export AWS_ENDPOINT_URL_S3="https://${TF_VAR_cloudflare_account_id}.r2.cloudflarestorage.com"

# Add this after choosing and registering a domain. Until then only Pages is created.
# export TF_VAR_domain_name="example.de"
